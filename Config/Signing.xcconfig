//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname
//
// Find your team ID in Xcode › Settings › Accounts, or developer.apple.com › Membership.

BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =

